# Generated / local artefacts
data/processed/
data/raw/
rag/index/store/
*.sqlite
*.sqlite3
# SQLite writes sidecar files that *.sqlite does not match; they are
# runtime checkpoint state, not source, and 5.4 MB of them reached a commit.
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
*.db

# Hidden test set must never be committed
evals/datasets/hidden/

# Node / Next.js
node_modules/
.next/
out/
apps/web/.env*.local
playwright-report/
test-results/

# Traces and logs
logs/
*.log

# Local run artefacts
*.log
# ...but committed evidence is the exception. Every number in the report has
# to trace to a file in the repository, and `*.log` was quietly excluding the
# traces the report cites - the README described files a clone would not have.
!evals/results/traces/*.log
demo_checkpoints.sqlite
ci.sqlite
