# ---------------------------------------------------------------------------
# GigBid environment template. Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------
APP_ENV=development
APP_SECRET_KEY=change_me_to_a_long_random_string
APP_BASE_URL=http://localhost:8000

# The two variables a public deployment must change. The API rejects a browser
# origin that is not listed here, and the web app calls localhost unless told
# otherwise, so leaving either at its default is the usual cause of a deployed
# UI that loads but cannot reach its API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Persistence -----------------------------------------------------------
# Postgres in docker compose; falls back to SQLite when unset.
DATABASE_URL=postgresql+psycopg://gigbid:gigbid@localhost:5432/gigbid
CHECKPOINT_DATABASE_URL=postgresql://gigbid:gigbid@localhost:5432/gigbid
REDIS_URL=redis://localhost:6379/0

# --- Marketplace -----------------------------------------------------------
# gigsim | upwork_live
MARKETPLACE_MODE=gigsim
GIGSIM_BASE_URL=http://localhost:8081
GIGSIM_API_TOKEN=gigsim-dev-token

# --- Live Upwork (official MCP server, OAuth 2.1) --------------------------
UPWORK_MCP_URL=https://mcp.upwork.com/mcp
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_REDIRECT_URI=http://localhost:8000/auth/upwork/callback
# Fernet key used to encrypt OAuth tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Third-party MCP -------------------------------------------------------
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
GITHUB_TOKEN=

# --- Models ----------------------------------------------------------------
# open | paid   (the deployed link must work on `open`)
MODEL_PROFILE=open

# Any OpenAI-compatible endpoint: Groq, OpenRouter, Together, Ollama, vLLM.
OPEN_LLM_BASE_URL=https://api.groq.com/openai/v1
OPEN_LLM_API_KEY=
# Optional second open provider used as the fallback for cheap nodes
OPEN_LLM_FALLBACK_BASE_URL=
OPEN_LLM_FALLBACK_API_KEY=

PAID_LLM_BASE_URL=https://api.openai.com/v1
PAID_LLM_API_KEY=

# Embeddings: local | hosted | hash
EMBEDDING_BACKEND=local
EMBEDDING_HOSTED_BASE_URL=
EMBEDDING_HOSTED_API_KEY=

# --- Observability ---------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gigbid

# --- Reviewer account seeded for graders -----------------------------------
REVIEWER_EMAIL=reviewer@gigbid.app
REVIEWER_PASSWORD=
