# syntax=docker/dockerfile:1.7
FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential curl \
 && rm -rf /var/lib/apt/lists/*

# Which embedding backend this image is built for.
#
# Declared here, before the install, because it decides whether torch is
# needed at all. It is also used further down, where the vector index is baked
# into the image: the backend that builds the index must be the backend that
# queries it, and Render passes service environment variables to Docker builds
# as build args so the same value reaches both sides.
#
# Changing EMBEDDING_BACKEND therefore requires a rebuild, not a restart.
ARG EMBEDDING_BACKEND=local
ENV EMBEDDING_BACKEND=${EMBEDDING_BACKEND}

COPY pyproject.toml ./
# Install dependencies in their own layer so code changes do not re-resolve.
#
# The stub directories are load-bearing. `pip install -e .` runs setuptools'
# egg_info, which fails with "package directory 'agent' does not exist" unless
# every entry in pyproject's `packages` list is present. Only pyproject.toml
# has been copied at this point, so without the stubs this layer cannot build
# at all -- and because the fallback after `||` is the same editable install,
# it fails too and the error reads as a dependency problem rather than a
# missing directory.
#
# The real source is copied over the stubs below. The install is editable, so
# it resolves against whatever is on disk at run time, and the dependency
# resolution stays in its own cached layer.
# The [embed] extra is installed only when it will actually be used. It pulls
# sentence-transformers and torch, and the torch wheel alone is 888 MB -- on a
# free host that is most of the build time and most of the disk, downloaded to
# support a backend the deployment has explicitly turned off. A hash-backed
# image needs none of it.
#
# Written on one line on purpose: this file is CRLF, and a backslash
# continuation followed by a carriage return escapes the CR instead of
# continuing the line, so the next line is parsed as an instruction and the
# build dies with "unknown instruction: &&".
RUN mkdir -p agent rag gigsim mcp_servers worker evals apps && pip install --upgrade pip && if [ "$EMBEDDING_BACKEND" = "local" ]; then pip install -e ".[embed]"; else echo "EMBEDDING_BACKEND=$EMBEDDING_BACKEND: skipping the [embed] extra (no torch)"; pip install -e .; fi

COPY agent/ ./agent/
COPY rag/ ./rag/
COPY mcp_servers/ ./mcp_servers/
COPY apps/api/ ./apps/api/
COPY worker/ ./worker/
COPY evals/ ./evals/
COPY gigsim/ ./gigsim/
COPY scripts/ ./scripts/
COPY data/ ./data/

# The index is baked with the backend declared at the top of this file, so the
# backend that builds it is the backend that queries it. A mismatch would not
# raise -- the hash embedder and bge-small are both 384-dimensional -- so
# retrieval would silently return noise; CorpusIndex.load refuses that
# combination outright.
#
# Pre-build the vector index at image build time: a cold first request that
# spends 110s embedding the corpus looks like an outage to the user.
RUN python -m scripts.generate_corpus --seed 20261115 \
 && python -m scripts.generate_jobs --seed 20261115 \
 && python -c "from rag.retriever import get_index; get_index(); print('index warm')" || true

RUN useradd -m -u 10001 gigbid && chown -R gigbid:gigbid /app
USER gigbid

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD curl -fsS "http://localhost:${PORT:-8000}/health" || exit 1

# Shell form so ${PORT} expands. Managed hosts (Render, Fly, Cloud Run)
# assign the port and route to it; a container that ignores it is
# reported as having no open ports and the deploy is marked failed.
# Defaults to 8000, so compose and the local workflow are unchanged.
CMD ["sh", "-c", "exec uvicorn apps.api.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
